# Dependencies
node_modules/

# Environment (keep .env.example)
.env
.env.local
!.env.example

# OS
.DS_Store
Thumbs.db

# OpenClaw state (in repo but sensitive files ignored)
.openclaw/agents/*/auth-profiles.json
.openclaw/credentials/
.openclaw/identity/
.openclaw/*.lock
.openclaw/cron/
.openclaw/telegram/

# Legacy (if running from wrong dir)
agents/
credentials/
cron/
telegram/
*.lock
update-check.json

# ClawHub runtime state
.clawhub/

# Hermes runtime state (keep config.yaml, ignore the rest)
.hermes/sessions/
.hermes/logs/
.hermes/pairing/
.hermes/image_cache/
.hermes/audio_cache/
.hermes/memories/
.hermes/cron/
.hermes/.env
.hermes/auth.json

# Workspace is symlinked to Google Drive (not tracked in git)
workspace
workspace.bak/

# Logs
*.log
