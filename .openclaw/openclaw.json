{
  "models": {
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek/deepseek-chat",
            "name": "DeepSeek V3.2",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "google/gemini-2.5-flash-lite",
            "name": "Gemini 2.5 Flash Lite",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "google/gemini-3-flash",
            "name": "Gemini 3 Flash",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-chat",
        "fallbacks": [
          "anthropic/claude-sonnet-4-6",
          "anthropic/claude-haiku-4-5"
        ]
      },
      "workspace": "./workspace",
      "compaction": {
        "reserveTokensFloor": 20000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000,
          "systemPrompt": "Session nearing compaction. Store durable memories now.",
          "prompt": "Write any lasting notes to memory/ daily file or MEMORY.md; reply NO_REPLY if nothing to store."
        }
      },
      "heartbeat": {
        "directPolicy": "allow",
        "model": "openrouter/google/gemini-2.5-flash-lite"
      },
      "memorySearch": {
        "enabled": true,
        "provider": "openai",
        "model": "voyage-3",
        "fallback": "none",
        "remote": {
          "baseUrl": "https://api.voyageai.com/v1/",
          "apiKey": "${VOYAGE_API_KEY}"
        },
        "query": {
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "candidateMultiplier": 4
          }
        },
        "cache": {
          "enabled": true,
          "maxEntries": 50000
        },
        "sync": {
          "watch": true
        },
        "extraPaths": ["./book-notes", "./standards"]
      },
      "imageModel": {
        "primary": "openrouter/google/gemini-3-flash",
        "fallbacks": ["anthropic/claude-sonnet-4-6"]
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8,
        "model": "openrouter/deepseek/deepseek-chat"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true
  },
  "session": {
    "scope": "per-sender",
    "reset": {
      "mode": "idle",
      "idleMinutes": 240
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "allowFrom": ["5810543997"],
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "groupPolicy": "allowlist",
      "streamMode": "partial"
    },
    "discord": {
      "groupPolicy": "open",
      "dmPolicy": "open",
      "allowFrom": ["*"]
    },
    "signal": {
      "enabled": true,
      "account": "+19492572803",
      "cliPath": "signal-cli",
      "dmPolicy": "pairing",
      "allowFrom": ["+18016943985"]
    }
  },
  "gateway": {
    "port": 3000,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "token": "${GATEWAY_TOKEN}"
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${WEBHOOK_TOKEN}"
  },
  "skills": {
    "load": {
      "extraDirs": ["./skills", "./workspace/skills"]
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "talk": {
    "apiKey": "${ELEVENLABS_API_KEY}"
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "discord": {
        "enabled": true
      }
    }
  }
}
